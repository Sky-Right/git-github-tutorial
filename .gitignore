# Publish only the tutorial sources. Other local projects and old exports stay local.
/*
!/.gitignore
!/.github/
!/README.md
!/requirements.txt
!/build-git.sh
!/snclogo.png
!/content/
/content/*
!/content/git-en.md
!/engine/
/engine/*
!/engine/build.py
!/engine/git_diagrams.py
!/engine/qa_git.cjs
!/engine/test_standalone.py
!/engine/verify_git_examples.py
!/engine/prepare_vscode_captures.py
!/theme/
/theme/*
!/theme/git.html
!/theme/git-course.css
!/theme/fonts/
!/theme/vendor/
!/images/
/images/*
!/images/git-course/
!/images/vscode/
!/examples/
!/LICENSES/
!/docs/
/docs/*
!/docs/maintenance.md
